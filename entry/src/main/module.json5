{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "launchType": "singleton",
        "continuable": true,
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        // Launch Screen.storyboard: splashscreen-wordmark over splashscreen-background.
        "startWindow": "$profile:start_window",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            "actions": [
              "ohos.want.action.viewData"
            ],
            "entities": [
              "entity.system.browsable"
            ],
            "uris": [
              { "scheme": "https", "host": "wikipedia.org" },
              { "scheme": "https", "host": "*.wikipedia.org" }
            ]
          },
          {
            // CFBundleURLTypes: wikipedia://explore, places, saved, activity, search, random,
            // wikipedia://<lang>.wikipedia.org/wiki/<title> (wmf_activityForWikipediaScheme)
            "actions": [
              "ohos.want.action.viewData"
            ],
            "entities": [
              "entity.system.browsable"
            ],
            "uris": [
              { "scheme": "wikipedia" },
              { "scheme": "wikipedia-official" }
            ]
          }
        ],
        // UIApplicationShortcutItems: Random article, Nearby articles, Search Wikipedia
        "metadata": [
          {
            "name": "ohos.ability.shortcuts",
            "resource": "$profile:shortcuts_config"
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        // deferred-task target for the daily background feed refresh: startWork's WorkInfo
        // names this ability, and the OS rejects a WorkInfo whose extension is undeclared.
        "name": "FeedRefreshExtension",
        "srcEntry": "./ets/workscheduler/FeedRefreshExtension.ets",
        "type": "workScheduler",
        "exported": false
      },
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:permission_location_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.LOCATION",
        "reason": "$string:permission_location_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}